# ───────── الذكاء الاصطناعي (OpenRouter) ─────────
# بدونه يشتغل النظام بقواعد نصية بسيطة، بس ما يقرأ الصور والفواتير.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# ───────── القناة ─────────
# simulator / telegram / whatsapp  (تقدر تغيرها بعدين من شاشة الإعدادات)
DEFAULT_CHANNEL=simulator

# تيليجرام: من @BotFather. polling يشتغل محلياً وعلى السيرفر بدون رابط عام.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling

# واتساب (Meta Cloud API) — جاهز في الكود، يتفعّل مع عميل حقيقي
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=salon-ops-verify
WHATSAPP_APP_SECRET=

# ───────── عام ─────────
TIMEZONE=Asia/Riyadh
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000

# ───────── للسيرفر فقط (docker-compose.prod.yml) ─────────
# الدومين اللي يطلع له شهادة HTTPS. بدون دومين استخدم: <IP>.sslip.io
API_DOMAIN=
POSTGRES_PASSWORD=
